{
  "name": "directus-extension-json-table",
  "description": "Read-only table interface for Directus JSON fields: draws the field's value as a table with colours, icons, links, sticky rows and columns, and a legend",
  "version": "1.0.1",
  "license": "MIT",
  "author": {
    "name": "David Krutsko",
    "email": "dave@krutsko.net",
    "url": "https://krutsko.net"
  },
  "homepage": "https://github.com/dkrutsko/directus-extension-json-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkrutsko/directus-extension-json-table.git"
  },
  "bugs": {
    "url": "https://github.com/dkrutsko/directus-extension-json-table/issues"
  },
  "icon": "table_chart",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-interface",
    "json",
    "table",
    "matrix",
    "grid",
    "read-only"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "interface",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.15.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test && npm run build && npm run validate"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "@directus/tsconfig": "^4.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.17.1",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "vue": "^3.5.24",
    "vue-tsc": "^3.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
