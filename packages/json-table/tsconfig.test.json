{
	// Type-checks the tests together with the framework-free code they import
	// (src/table.ts). `npm run check` runs it after vue-tsc. There is no DOM
	// library here on purpose: table.ts also has to run in Node, where the
	// tests run it, so any accidental use of a browser-only global fails this
	// check. The streams, `atob` and `TextDecoder` it does use are globals in
	// Node as well, and come from the Node typings.
	"extends": "@directus/tsconfig/base",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ES2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"declaration": false,
		"types": ["node"]
	},
	"include": [
		"./src/table.ts",
		"./tests/**/*.ts",
		"./vitest.config.ts"
	],
	"exclude": [
		"./node_modules/**",
		"./dist/**"
	]
}
