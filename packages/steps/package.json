{
  "name": "directus-extension-steps",
  "description": "Steps interface and display for Directus: a field with an ordered list of choices drawn as a clickable progress track, and a compact progress display for layouts",
  "version": "1.0.1",
  "license": "MIT",
  "author": {
    "name": "David Krutsko",
    "email": "dave@krutsko.net",
    "url": "https://krutsko.net"
  },
  "homepage": "https://github.com/dkrutsko/directus-extensions/tree/main/packages/steps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkrutsko/directus-extensions.git",
    "directory": "packages/steps"
  },
  "bugs": {
    "url": "https://github.com/dkrutsko/directus-extensions/issues"
  },
  "icon": "step",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "steps",
    "stepper",
    "progress",
    "workflow",
    "status",
    "stages"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "interface",
        "name": "steps",
        "source": "src/interface.ts"
      },
      {
        "type": "display",
        "name": "steps-display",
        "source": "src/display.ts"
      }
    ],
    "host": "^11.15.0",
    "partial": false
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test && npm run build && npm run validate"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "@directus/tsconfig": "^4.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "vue": "^3.5.24",
    "vue-tsc": "^3.2"
  }
}
